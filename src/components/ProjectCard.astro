---
import { link } from '../lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
	index: number;
	priority?: boolean;
}
const { project, index, priority = false } = Astro.props;
const { title, venue, location, summary, cover, tags } = project.data;
---

<a
	href={link(`/work/${project.id}`)}
	class="group block"
	data-anim="rise"
>
	<div class="relative aspect-[4/3] overflow-clip bg-ink-raised" data-reveal-frame>
		<div class="absolute inset-x-0 -top-px bottom-px overflow-clip">
		<div
			class="absolute inset-0 transition-transform duration-[1.1s] ease-out-expo group-hover:scale-[1.05]"
		>
		<Image
			src={cover}
			alt=""
			widths={[480, 800, 1200]}
			sizes="(min-width: 1024px) 45vw, 92vw"
			loading={priority ? 'eager' : 'lazy'}
			data-parallax="6"
			class="absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover"
		/>
		</div>
		</div>
		<div
			class="pointer-events-none absolute inset-x-0 -top-px -bottom-px bg-gradient-to-t from-ink/95 via-ink/55 to-ink/10"
		>
		</div>
		<span
			class="absolute top-4 left-4 font-display text-sm text-gold lining-nums tabular-nums"
			>{String(index + 1).padStart(2, '0')}</span
		>
		<div class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
			<h2 class="font-display text-3xl text-bone transition-colors group-hover:text-gold sm:text-4xl">
				{title}
			</h2>
			<p class="mt-1 text-sm text-bone/85">{venue ? `${venue} — ${location}` : location}</p>
			<span
				aria-hidden="true"
				class="mt-3 block h-px w-0 bg-gold transition-[width] duration-700 ease-out-expo group-hover:w-24"
			/>
		</div>
	</div>
	<p class="mt-4 max-w-xl text-sm leading-relaxed text-ash">{summary}</p>
	<ul class="mt-3 flex flex-wrap gap-2">
		{
			tags.slice(0, 3).map((tag) => (
				<li class="border border-ink-line px-2.5 py-1 text-[0.65rem] tracking-[0.16em] text-ash uppercase">
					{tag}
				</li>
			))
		}
	</ul>
</a>
