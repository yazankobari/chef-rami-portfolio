---
import { link } from '../lib/url';
import { builtBy, contact, profile } from '../data/site';
import ContactIcon from './ContactIcon.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-line bg-ink">
	<div class="mx-auto max-w-[110rem] px-5 py-14 sm:px-8">
		<div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
			<div>
				<p class="font-display text-3xl text-bone">{profile.name}</p>
				<p class="eyebrow mt-2">{profile.role}</p>
				<p class="mt-5 max-w-sm text-sm leading-relaxed text-ash">{profile.tagline}</p>
			</div>

			<nav aria-label="Footer">
				<p class="eyebrow">Site</p>
				<ul class="mt-4 space-y-2 text-sm text-ash">
					<li><a class="transition-colors hover:text-gold" href={link("/")}>Home</a></li>
					<li><a class="transition-colors hover:text-gold" href={link("/work")}>Work</a></li>
					<li><a class="transition-colors hover:text-gold" href={link("/about")}>About</a></li>
					<li><a class="transition-colors hover:text-gold" href={link("/#services")}>Services</a></li>
				</ul>
			</nav>

			<div>
				<p class="eyebrow">Contact</p>
				<ul class="mt-4 space-y-2 text-sm text-ash">
					<li>
						<a
							class="flex items-center gap-2.5 transition-colors hover:text-gold"
							href={`mailto:${contact.email}`}
						>
							<ContactIcon name="mail" />
							<span class="break-all">{contact.email}</span>
						</a>
					</li>
					<li>
						<a
							class="flex items-center gap-2.5 transition-colors hover:text-gold"
							href={contact.whatsappUrl}
							rel="noopener"
							target="_blank"
						>
							<ContactIcon name="whatsapp" />
							<span>{contact.phone}<span class="sr-only"> on WhatsApp (opens in a new tab)</span></span>
						</a>
					</li>
					<li>
						<a
							class="flex items-center gap-2.5 transition-colors hover:text-gold"
							href={contact.instagramUrl}
							rel="me noopener"
							target="_blank"
						>
							<ContactIcon name="instagram" />
							<span>@{contact.instagram}</span>
						</a>
					</li>
					<li class="flex items-center gap-2.5">
						<ContactIcon name="pin" />
						<span>{contact.base}</span>
					</li>
				</ul>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col gap-2 border-t border-ink-line pt-6 text-xs text-ash sm:flex-row sm:items-center sm:justify-between"
		>
			<p>&copy; {year} {profile.name}. All rights reserved.</p>
			<p>
				Site by{' '}
				<a
					class="transition-colors hover:text-gold"
					href={builtBy.url}
					rel="noopener"
					target="_blank"
				>
					{builtBy.name}<span class="sr-only"> (opens in a new tab)</span>
				</a>
			</p>
		</div>
	</div>
</footer>
