---
import { contact, profile } from '../data/site';
---

<section class="mx-auto max-w-[110rem] px-5 pt-24 pb-24 sm:px-8 sm:pt-32">
	<div id="contact" class="bg-gold px-6 py-14 text-ink sm:px-14 sm:py-20" data-anim="rise">
		<p class="text-[0.6875rem] tracking-[0.28em] text-ink/75 uppercase">Contact me</p>
		<h2 class="mt-5 max-w-4xl font-display text-title font-light text-balance">
			Let&rsquo;s prepare the recipe for your restaurant success.
		</h2>
		<p class="mt-6 max-w-xl text-base leading-relaxed text-ink/80">{profile.quote}</p>

		<a
			href={`mailto:${contact.email}`}
			class="mt-9 inline-block border border-ink bg-ink px-6 py-4 text-[0.7rem] tracking-[0.16em] whitespace-nowrap text-bone uppercase transition-colors hover:bg-transparent hover:text-ink sm:px-8 sm:text-xs sm:tracking-[0.2em]"
			>Start a conversation</a
		>

		<div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			<a href={`mailto:${contact.email}`} class="group block border-t border-ink/25 pt-4">
				<span class="text-[0.6875rem] tracking-[0.22em] text-ink/75 uppercase">Email</span>
				<span class="mt-2 block text-lg break-words group-hover:underline">{contact.email}</span>
			</a>
			<a
				href={contact.whatsappUrl}
				target="_blank"
				rel="noopener"
				class="group block border-t border-ink/25 pt-4"
			>
				<span class="text-[0.6875rem] tracking-[0.22em] text-ink/75 uppercase">WhatsApp</span>
				<span class="mt-2 block text-lg group-hover:underline"
					>{contact.phone}<span class="sr-only"> (opens in a new tab)</span></span
				>
			</a>
			<a
				href={contact.instagramUrl}
				target="_blank"
				rel="me noopener"
				class="group block border-t border-ink/25 pt-4"
			>
				<span class="text-[0.6875rem] tracking-[0.22em] text-ink/75 uppercase">Instagram</span>
				<span class="mt-2 block text-lg group-hover:underline"
					>@{contact.instagram}<span class="sr-only"> (opens in a new tab)</span></span
				>
			</a>
		</div>
	</div>
</section>
