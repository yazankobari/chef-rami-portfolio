---
import { link } from '../../lib/url';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactBlock from '../../components/ContactBlock.astro';

export async function getStaticPaths() {
	const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}

const { project, next } = Astro.props;
const { title, venue, location, period, summary, scope, tags, cover, coverFocus, clips, gallery, url } =
	project.data;
const { Content } = await render(project);

// Share cards must be landscape. Astro's sharp service refuses to enlarge, so clamp the
// requested size to what the source can actually supply at 1.91:1.
const shareWidth = Math.min(1200, cover.width, Math.round((cover.height * 1200) / 630));
const share = await getImage({
	src: cover,
	width: shareWidth,
	height: Math.round((shareWidth * 630) / 1200),
	format: 'jpeg',
	quality: 82,
});

const breadcrumbs = {
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL(link('/'), Astro.site).href },
		{ '@type': 'ListItem', position: 2, name: 'Work', item: new URL(link('/work'), Astro.site).href },
		{ '@type': 'ListItem', position: 3, name: title },
	],
};

// Posters can't use srcset, so size them once here rather than shipping the source JPEG.
const clipPosters = await Promise.all(
	clips.map((clip) => getImage({ src: clip.poster, width: 800, format: 'webp', quality: 74 }))
);

const projectSchema = {
	'@type': 'CreativeWork',
	name: title,
	description: summary,
	locationCreated: { '@type': 'Place', name: location },
	creator: { '@id': new URL(link('/'), Astro.site).href + '#chef' },
	...(url ? { sameAs: url } : {}),
};
---

<Base
	title={`${title} — Rami Al Maket`}
	description={summary}
	image={share.src}
	imageWidth={share.attributes.width ?? shareWidth}
	imageHeight={share.attributes.height ?? Math.round((shareWidth * 630) / 1200)}
	imageAlt={`${title} — ${venue}, ${location}`}
	ogType="article"
	schemaNodes={[projectSchema, breadcrumbs]}
>
	<article>
		<header data-hero class="relative flex min-h-[70svh] items-end overflow-hidden">
			<div class="absolute inset-0" data-reveal-frame>
			<Image
				src={cover}
				alt={`${title} — ${venue}, ${location}`}
				widths={[800, 1400, 2000]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
				data-hero-image
				style={`object-position:${coverFocus}`}
				class="absolute inset-0 h-full w-full origin-center object-cover will-change-transform"
			/>
			</div>
			<div class="absolute inset-x-0 -top-px -bottom-px bg-gradient-to-t from-ink via-ink/70 to-ink/30"></div>
			<div data-hero-type class="relative mx-auto w-full max-w-[110rem] px-5 pt-40 pb-14 sm:px-8">
				<a
					href={link("/work")}
					data-hero-item
					class="eyebrow inline-block transition-colors hover:text-bone">&larr; All work</a
				>
				<h1 class="mt-6 font-display text-title font-light text-bone" data-hero-item>{title}</h1>
				<p class="mt-4 max-w-2xl text-lede text-ash" data-hero-item>
					{venue ? `${venue} — ${location}` : location}
				</p>
			</div>
		</header>

		<div
			class="mx-auto grid max-w-[110rem] items-start gap-14 px-5 py-20 sm:px-8 lg:grid-cols-[20rem_1fr] lg:gap-20"
		>
			<aside class="order-1 lg:sticky lg:top-28 lg:self-start">
				<dl class="space-y-8 text-sm">
					<div class="border-t border-ink-line pt-4">
						<dt class="eyebrow">Location</dt>
						<dd class="mt-2 text-bone">{location}</dd>
					</div>
					{
						period && (
							<div class="border-t border-ink-line pt-4">
								<dt class="eyebrow">Period</dt>
								<dd class="mt-2 text-bone">{period}</dd>
							</div>
						)
					}
					{
						scope.length > 0 && (
							<div class="border-t border-ink-line pt-4">
								<dt class="eyebrow">Scope</dt>
								<dd>
									<ul class="mt-3 space-y-2 text-ash">
										{scope.map((s) => (
											<li class="flex gap-2">
												<span class="text-gold" aria-hidden="true">&#47;</span>
												{s}
											</li>
										))}
									</ul>
								</dd>
							</div>
						)
					}
					{
						tags.length > 0 && (
							<div class="border-t border-ink-line pt-4">
								<dt class="eyebrow">Cuisine &amp; focus</dt>
								<dd class="mt-3 flex flex-wrap gap-2">
									{tags.map((tag) => (
										<span class="border border-ink-line px-2.5 py-1 text-[0.8125rem] tracking-[0.16em] text-ash uppercase">
											{tag}
										</span>
									))}
								</dd>
							</div>
						)
					}
					{
						url && (
							<div class="border-t border-ink-line pt-4">
								<dt class="eyebrow">Website</dt>
								<dd class="mt-2">
									<a
										href={url}
										target="_blank"
										rel="noopener"
										class="text-gold break-all underline-offset-4 hover:underline"
									>
										{url.replace(/^https?:\/\//, '')}
									</a>
								</dd>
							</div>
						)
					}
				</dl>
			</aside>

			<div
				class="order-2 prose-invert max-w-[68ch] space-y-6 text-lg leading-relaxed text-ash [&_a]:text-gold [&_h2]:mt-14 [&_h2]:font-display [&_h2]:text-3xl [&_h2]:font-light [&_h2]:text-bone [&_strong]:font-normal [&_strong]:text-bone [&_table]:w-full [&_table]:text-sm [&_td]:border-b [&_td]:border-ink-line [&_td]:py-2.5 [&_th]:border-b [&_th]:border-ink-line [&_th]:py-2.5 [&_th]:text-left [&_th]:text-gold"
				data-anim="rise"
			>
				<Content />
		{
			gallery.length > 0 && (
				<section class="mt-16">
					{
						clips.length > 0 && (
							<div class="mb-6 grid gap-6 sm:grid-cols-2">
								{clips.map((clip, ci) => (
									<figure data-reveal-frame>
										{/* Own controls, not the browser's: controlsList is advisory in
										    Chromium and ignored outright in Safari, so download / fullscreen
										    / picture-in-picture can only be removed by not offering them. */}
										<div class="group relative overflow-clip bg-ink" data-player>
											<video
												data-clip
												src={clip.src}
												poster={clipPosters[ci].src}
												playsinline
												preload="metadata"
								disablepictureinpicture
												class="w-full object-cover"
											/>
											<button
												type="button"
												data-clip-toggle
												aria-label={`Play: ${clip.alt}`}
												class="absolute inset-0 grid cursor-pointer place-items-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-gold"
											>
												<span
													data-clip-badge
													class="grid h-16 w-16 place-items-center rounded-full border border-bone/40 bg-ink/55 text-bone backdrop-blur-sm transition group-hover:border-gold group-hover:text-gold"
												>
													<svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 fill-current" aria-hidden="true">
														<path d="M8 5v14l11-7z" />
													</svg>
												</span>
											</button>
											<div
												data-clip-bar
												class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center gap-3 bg-gradient-to-t from-ink/85 to-transparent px-4 pt-8 pb-3 opacity-0 transition-opacity"
											>
												<span data-clip-time class="text-xs tabular-nums text-bone/80">0:00</span>
												<button
													type="button"
													data-clip-seek
													aria-label="Seek"
													class="pointer-events-auto flex-1 cursor-pointer py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold"
												>
													<span class="block h-[3px] overflow-hidden rounded-full bg-bone/25">
														<span data-clip-progress class="block h-full w-0 bg-gold" />
													</span>
												</button>
												<button
													type="button"
													data-clip-mute
													aria-label="Mute"
													class="pointer-events-auto cursor-pointer text-bone/80 transition hover:text-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold"
												>
													<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
														<path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z" />
													</svg>
												</button>
											</div>
										</div>
										<figcaption class="mt-2 text-xs text-ash">{clip.alt}</figcaption>
									</figure>
								))}
							</div>
						)
					}

					<div class="columns-1 gap-6 sm:columns-2">
						{gallery.map((img, i) => (
							<div class="mb-6 break-inside-avoid overflow-hidden" data-reveal-frame>
								<Image
									src={img}
									alt={`${title}, ${location} — photograph ${i + 1} of ${gallery.length}`}
									widths={[400, 700, 1000]}
									sizes="(min-width: 1280px) 30rem, (min-width: 1024px) 26vw, (min-width: 640px) 40vw, 90vw"
									loading="lazy"
									class="w-full object-cover"
								/>
							</div>
						))}
					</div>
				</section>
			)
		}
			</div>
		</div>

		<nav class="border-t border-ink-line" aria-label="Next project">
			<a href={link(`/work/${next.id}`)} class="group block">
				<div class="mx-auto flex max-w-[110rem] items-center justify-between gap-6 px-5 py-14 sm:px-8">
					<div>
						<p class="eyebrow">Next project</p>
						<p class="mt-3 font-display text-4xl text-bone transition-colors group-hover:text-gold sm:text-6xl">
							{next.data.title}
						</p>
					</div>
					<span
						aria-hidden="true"
						class="text-3xl text-gold transition-transform group-hover:translate-x-2 sm:text-5xl"
						>&rarr;</span
					>
				</div>
			</a>
		</nav>
	</article>

	<ContactBlock />
</Base>
