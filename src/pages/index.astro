---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Marquee from '../components/Marquee.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { profile, stats, countries, services, process, awards, pressFeatured, pressMore } from '../data/site';
import heroPortrait from '../assets/site/hero-portrait.png';
import heroPortraitMobile from '../assets/site/hero-portrait-mobile.png';
import plating from '../assets/site/plating.jpg';
import awardsPhoto from '../assets/site/awards-photo.jpg';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.slice(0, 4);

// Art direction: a portrait crop for phones, the landscape frame above sm. Emitted as a
// <picture> so the browser downloads exactly one of them.
const heroMobileSet = await Promise.all(
	[420, 640, 900].map((w) => getImage({ src: heroPortraitMobile, width: w, format: 'webp' }))
);
const heroDesktopSet = await Promise.all(
	[1000, 1400, 2000, 2800].map((w) => getImage({ src: heroPortrait, width: w, format: 'webp' }))
);
const heroMobileSrcset = heroMobileSet.map((i) => `${i.src} ${i.attributes.width}w`).join(', ');
const heroDesktopSrcset = heroDesktopSet.map((i) => `${i.src} ${i.attributes.width}w`).join(', ');
---

<Base title="Rami Al Maket — Consultant Chef">
	<!-- Hero -->
	<div data-hero-wrap class="relative h-[140svh] sm:h-[185svh]">
	<section data-hero class="sticky top-0 flex h-[100svh] items-end overflow-hidden">
		<div class="absolute inset-0" data-reveal-frame>
			<picture>
				<source media="(max-width: 639px)" srcset={heroMobileSrcset} sizes="100vw" type="image/webp" />
				<source srcset={heroDesktopSrcset} sizes="100vw" type="image/webp" />
				<img
					src={heroDesktopSet[1].src}
					alt="Chef Rami Al Maket"
					width={heroDesktopSet[1].attributes.width}
					height={heroDesktopSet[1].attributes.height}
					fetchpriority="high"
					decoding="async"
					data-hero-image
					class="absolute inset-0 h-full w-full origin-center object-cover object-[42%_center] opacity-90 will-change-transform sm:object-[72%_center]"
				/>
			</picture>
		</div>
		<div
			data-hero-curtain
			aria-hidden="true"
			class="absolute inset-x-0 bottom-0 z-10 h-full origin-bottom [transform:scaleY(0)] bg-ink"
		>
		</div>
		<div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/75 to-ink/20 sm:bg-gradient-to-r sm:from-ink sm:via-ink/85 sm:to-ink/45 xl:to-transparent"></div>
		<div class="absolute inset-x-0 -bottom-px h-40 bg-gradient-to-t from-ink to-transparent"></div>

		<div
			data-hero-type
			class="relative mx-auto w-full max-w-[110rem] px-5 pt-32 pb-14 sm:px-8 sm:pb-20"
		>
			<p class="eyebrow" data-hero-item style="--hero-index:0">Consultant Chef &mdash; Dubai, UAE</p>
			<h1 class="mt-6 font-display text-display font-light text-bone">
				<span class="block" data-hero-item style="--hero-index:1">Rami</span>
				<span class="block text-gold italic" data-hero-item style="--hero-index:2">Al Maket</span>
			</h1>
			<p class="mt-8 max-w-md text-lede text-bone/90 lg:max-w-xl" data-hero-item style="--hero-index:3">{profile.tagline}</p>

			<div class="mt-10 flex flex-wrap items-center gap-4" data-hero-item style="--hero-index:4">
				<a
					href="/work"
					class="border border-gold bg-gold px-7 py-3.5 text-xs tracking-[0.2em] text-ink uppercase transition-colors hover:bg-transparent hover:text-gold"
					>Selected work</a
				>
				<a
					href="#services"
					class="border border-ink-line px-7 py-3.5 text-xs tracking-[0.2em] text-bone uppercase transition-colors hover:border-gold hover:text-gold"
					>What I do</a
				>
			</div>
		</div>
	</section>
	</div>

	<Marquee
		items={[
			'Arabic',
			'Levantine',
			'Mediterranean',
			'Moroccan',
			'Turkish',
			'Italian',
			'Gulf',
			'Continental',
			'Japanese-influenced',
			'International',
		]}
	/>

	<!-- Intro -->
	<section class="border-t border-ink-line bg-ink">
		<div class="mx-auto max-w-[110rem] px-5 py-24 sm:px-8 sm:py-32">
			<div class="grid gap-14 lg:grid-cols-[1.15fr_1fr] lg:gap-20" data-anim-unit>
				<div data-anim="rise">
					<p class="eyebrow">Why Chef Rami</p>
					<p class="mt-6 font-display text-title font-light text-balance text-bone" data-split>
						26 years of kitchens, in nine countries, turned into a repeatable recipe for opening
						restaurants that last.
					</p>
					<div class="mt-8 max-w-2xl space-y-5 text-base leading-relaxed text-ash">
						<p>{profile.intro}</p>
						<p>{profile.bio}</p>
					</div>

					<dl class="mt-14 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="flex flex-col-reverse border-t border-ink-line pt-4">
									<dt class="mt-2 text-xs tracking-[0.14em] text-ash uppercase">{stat.label}</dt>
									<dd
										data-count={stat.value}
										class="font-sans text-5xl font-light text-gold lining-nums tabular-nums"
									>
										{stat.value}
									</dd>
								</div>
							))
						}
					</dl>

					<div class="mt-12 border-t border-ink-line pt-6">
						<p class="eyebrow">Kitchens across</p>
						<ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-ash">
							{countries.map((c) => <li>{c}</li>)}
						</ul>
					</div>
				</div>

				<div class="relative self-start" data-anim="rise">
					<div class="relative aspect-[4/5] max-h-[46rem] overflow-hidden" data-reveal-frame>
						<Image
							src={plating}
							alt="Chef Rami plating a dish"
							widths={[500, 800, 1100]}
							sizes="(min-width: 1024px) 40vw, 92vw"
							data-parallax="8"
							class="absolute inset-x-0 -top-[10%] h-[120%] w-full object-cover"
						/>
					</div>
					<p
						class="relative -mt-10 ml-0 max-w-sm bg-ink px-5 py-4 font-display text-xl text-balance text-bone italic sm:text-2xl lg:absolute lg:-bottom-6 lg:left-0 lg:mt-0"
					>
						&ldquo;{profile.quote}&rdquo;
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Services -->
	<section class="border-t border-ink-line bg-ink-raised">
		<div class="mx-auto max-w-[110rem] px-5 py-24 sm:px-8 sm:py-32">
			<SectionHead
				id="services"
				eyebrow="Services"
				title="360° support, from first sketch to steady service."
				lede="From concept development to menu creation, kitchen design, and cost-effective operations, I offer tailored solutions to meet your specific needs."
			/>

			<ol data-anim-group class="mt-16 border-t border-ink-line">
				{
					services.map((service, i) => (
						<li
							data-row
							class="group relative grid gap-3 border-b border-ink-line py-7 lg:grid-cols-[4rem_1.1fr_1.5fr] lg:items-baseline lg:gap-10 lg:px-4"
							data-anim="rise"
						>
							<span
								data-row-marker
								aria-hidden="true"
								class="absolute inset-x-0 bottom-0 h-px origin-left [transform:scaleX(0)] bg-gold"
							/>
							<span class="font-sans text-2xl font-light text-gold lining-nums tabular-nums">
								{String(i + 1).padStart(2, '0')}
							</span>
							<h3 class="font-display text-2xl text-bone transition-colors group-hover:text-gold lg:text-3xl">
								{service.title}
							</h3>
							<p class="max-w-2xl text-sm leading-relaxed text-ash">{service.body}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- Process -->
	<section class="border-t border-ink-line bg-ink">
		<div class="mx-auto max-w-[110rem] px-5 py-24 sm:px-8 sm:py-32">
			<SectionHead
				eyebrow="How it works"
				title="Four stages, one outcome: a kitchen that runs without me."
			/>
			<div data-anim-group class="mt-16 grid auto-rows-fr gap-px border border-ink-line bg-ink-line sm:grid-cols-2 lg:grid-cols-4">
				{
					process.map((step, i) => (
						<div class="group bg-ink p-7 transition-colors hover:bg-ink-raised sm:p-9" data-anim="rise">
							<span class="font-sans text-sm text-gold lining-nums tabular-nums">
								{String(i + 1).padStart(2, '0')}
							</span>
							<h3 class="mt-6 font-display text-2xl text-bone sm:text-3xl">{step.title}</h3>
							<p class="mt-4 text-sm leading-relaxed text-ash">{step.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Selected work -->
	<section class="border-t border-ink-line bg-ink-raised">
		<div class="mx-auto max-w-[110rem] px-5 py-24 sm:px-8 sm:py-32">
			<div class="flex flex-wrap items-end justify-between gap-6">
				<SectionHead
					eyebrow="Selected work"
					title="Restaurants built, rebuilt, and handed over running."
				/>
				<a
					href="/work"
					class="border-b border-gold/50 pb-1 text-xs tracking-[0.2em] text-gold uppercase transition-colors hover:border-gold"
					>All projects ({projects.length})</a
				>
			</div>

			<div data-anim-group class="mt-16 grid gap-x-8 gap-y-16 md:grid-cols-2">
				{
					featured.map((project, i) => (
						<ProjectCard project={project} index={i} />
					))
				}
			</div>
		</div>
	</section>

	<!-- Awards -->
	<section class="border-t border-ink-line bg-ink">
		<div
			class="mx-auto grid max-w-[110rem] gap-14 px-5 py-24 sm:px-8 sm:py-32 lg:grid-cols-[1fr_1.1fr] lg:gap-20"
			data-anim-unit
		>
			<div>
				<SectionHead eyebrow="Achievements" title="Recognised where it counts — on the floor." />
				<ul data-anim-group class="mt-12 border-t border-ink-line">
					{
						[...awards].sort((a, b) => Number(b.year) - Number(a.year)).map((award) => (
							<li class="grid gap-1 border-b border-ink-line py-5 last:border-b-0 sm:grid-cols-[4.5rem_1fr]" data-anim="rise">
								<span class="font-display text-lg text-gold lining-nums tabular-nums">{award.year}</span>
								<div>
									<h3 class="text-lg text-bone">{award.title}</h3>
									<p class="mt-1 text-sm text-ash">{award.org}</p>
									<p class="mt-1 text-sm text-ash">{award.note}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
			<div data-anim="rise" class="overflow-hidden" data-reveal-frame>
				<Image
					src={awardsPhoto}
					alt="Chef Rami holding the FACT Dining Awards for Amaseena"
					widths={[500, 900, 1280]}
					sizes="(min-width: 1024px) 45vw, 92vw"
					class="h-full max-h-[42rem] w-full object-cover"
				/>
			</div>
		</div>
	</section>

	<!-- Press -->
	<section class="border-t border-ink-line bg-ink-raised">
		<div class="mx-auto max-w-[110rem] px-5 py-24 sm:px-8 sm:py-32">
			<SectionHead eyebrow="In the media" title="Featured press & film." />
			<ul data-anim-group class="mt-14 grid gap-x-8 border-t border-ink-line sm:grid-cols-2 lg:grid-cols-3">
				{
					pressFeatured.map((item) => (
						<li class="border-b border-ink-line" data-anim="rise">
							<a
								href={item.url}
								target="_blank"
								rel="noopener"
								class="group flex items-baseline justify-between gap-4 py-5"
							>
								<span>
									<span class="block text-base text-bone transition-colors group-hover:text-gold">
										{item.outlet}
									</span>
									<span class="mt-1 block text-sm text-ash">{item.note}</span>
								</span>
								<span
									aria-hidden="true"
									class="text-gold transition-transform group-hover:translate-x-1"
								>
									&#8599;
								</span>
							</a>
						</li>
					))
				}
			</ul>

			<details class="group mt-8">
				<summary
					class="inline-flex cursor-pointer list-none items-center gap-3 text-xs tracking-[0.2em] text-gold uppercase transition-colors hover:text-bone"
				>
					More coverage
					<span class="transition-transform group-open:rotate-45" aria-hidden="true">+</span>
				</summary>
				<ul class="mt-6 grid gap-x-8 border-t border-ink-line sm:grid-cols-2 lg:grid-cols-3">
					{
						pressMore.map((item) => (
							<li class="border-b border-ink-line">
								<a
									href={item.url}
									target="_blank"
									rel="noopener"
									class="group/link flex items-baseline justify-between gap-4 py-4"
								>
									<span>
										<span class="block text-sm text-bone transition-colors group-hover/link:text-gold">
											{item.outlet}
										</span>
										<span class="mt-1 block text-xs text-ash">{item.note}</span>
									</span>
									<span aria-hidden="true" class="text-gold">&#8599;</span>
								</a>
							</li>
						))
					}
				</ul>
			</details>
		</div>
	</section>

	<ContactBlock />
</Base>
