---
import { link } from '../lib/url';
import Base from '../layouts/Base.astro';
---

<Base noindex title="Not found — Rami Al Maket"
	description="That page has moved or never existed. Browse the work, or get in touch.">
	<section class="mx-auto flex min-h-[70svh] max-w-[110rem] flex-col justify-center px-5 py-32 sm:px-8">
		<p class="eyebrow">404</p>
		<h1 class="mt-5 font-display text-title font-light text-bone">
			This dish left the pass.
		</h1>
		<p class="mt-6 max-w-lg text-lede text-ash">
			The page you are looking for is not on the menu. Try the work instead.
		</p>
		<a
			href={link("/")}
			class="mt-10 w-fit border border-gold bg-gold px-7 py-3.5 text-xs tracking-[0.2em] text-ink uppercase transition-colors hover:bg-transparent hover:text-gold"
			>Back home</a
		>
	</section>
</Base>
