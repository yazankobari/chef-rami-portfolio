---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkDeck from '../components/WorkDeck.astro';
import ContactBlock from '../components/ContactBlock.astro';
import logoChefRamis from '../assets/site/logo-chef-ramis-kitchen.png';
import logoSole from '../assets/site/logo-sole-burger.png';
import logoOlivaForno from '../assets/site/logo-oliva-forno.png';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const cloudKitchens = [
	{
		name: "Chef Rami's Kitchen",
		logo: logoChefRamis,
		body: 'Specialising in a modern fusion of authentic Arabic flavours and contemporary Western cuisine.',
	},
	{
		name: 'Sole Burger',
		logo: logoSole,
		body: 'A burger brand built for delivery. Not for sharing.',
	},
	{
		name: 'Oliva & Forno',
		logo: logoOlivaForno,
		body: 'A rustic Italian kitchen built for delivery. Wood-fired pizza and pasta worth making an evening of.',
	},
];
---

<Base
	title="Work — Rami Al Maket"
	description="Restaurants, cafés and cloud kitchens developed by consultant chef Rami Al Maket across Dubai, Abu Dhabi and beyond."
>
	<section class="mx-auto max-w-[110rem] px-5 pt-40 pb-16 sm:px-8 sm:pt-48" data-anim-unit>
		<p class="eyebrow">Selected work</p>
		<h1 data-anim="rise" class="rule-left mt-5 max-w-4xl font-display text-title font-light text-balance text-bone">
			Concepts, kitchens and teams &mdash; built from scratch and handed over running.
		</h1>
		<p class="mt-7 max-w-2xl text-lede text-ash" data-split>
			Eight venues across the UAE, from a Ritz-Carlton flagship to delivery-first cloud kitchens.
			Each one started with the same question: who are we cooking for, and how do we make it
			profitable?
		</p>
	</section>

	<section class="mx-auto max-w-[110rem] px-5 pb-24 sm:px-8">
		<WorkDeck projects={projects} />
	</section>

	<section class="border-t border-ink-line bg-ink-raised">
		<div class="mx-auto max-w-[110rem] px-5 py-20 sm:px-8">
			<p class="eyebrow" data-anim="rise">Also developed</p>
			<div class="mt-4 -ml-4 overflow-hidden pl-4">
				<h2
					data-anim="mask"
					class="rule-left pb-[0.16em] font-display text-3xl font-light text-bone sm:text-4xl"
				>
					Cloud kitchen brands
				</h2>
			</div>
			<p class="mt-6 max-w-xl text-lede text-ash" data-split>
				Three delivery-first brands developed end to end, from the kitchen through the menu to the
				recipes, for a market where the dining room is someone else&rsquo;s living room.
			</p>

			<div data-anim-group class="mt-14 grid auto-rows-fr gap-px border border-ink-line bg-ink-line sm:grid-cols-2 lg:grid-cols-3">
				{
					cloudKitchens.map((brand) => (
						<article
							class="group flex flex-col gap-7 bg-ink p-8 transition-colors duration-500 hover:bg-ink-raised sm:flex-row sm:items-start sm:p-10"
							data-anim="rise"
						>
							<div class="flex size-28 shrink-0 items-center justify-center rounded-full bg-ink-raised p-3 transition-transform duration-700 ease-out-expo group-hover:scale-105 sm:size-32">
								<Image
									src={brand.logo}
									alt={`${brand.name} logo`}
									width={140}
									densities={[1, 2]}
									class="h-full w-full object-contain"
								/>
							</div>
							<div>
								<p class="eyebrow">Cloud kitchen</p>
								<h3 class="mt-2 font-display text-2xl text-bone transition-colors group-hover:text-gold sm:text-3xl">
									{brand.name}
								</h3>
								<p class="mt-3 max-w-sm text-sm leading-relaxed text-ash">{brand.body}</p>
								<span
									aria-hidden="true"
									class="mt-5 block h-px w-10 bg-gold/40 transition-all duration-700 ease-out-expo group-hover:w-20 group-hover:bg-gold"
								/>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<ContactBlock />
</Base>
